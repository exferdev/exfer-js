{
  "name": "exfer-js",
  "version": "0.1.2",
  "description": "JavaScript/TypeScript SDK for the Exfer blockchain",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "exfer",
    "blockchain",
    "crypto",
    "wallet",
    "ed25519",
    "pow",
    "utxo"
  ],
  "author": "exferdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exferdev/exfer-js.git"
  },
  "homepage": "https://exfer.dev",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
